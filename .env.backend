# ============================================================
# PathOptix Backend - Docker 部署环境变量
# 用途: docker-compose.yml 通过 env_file 加载此文件到后端容器
# 使用方法: 复制此文件为 .env.backend 并填入实际值
#   cp .env.backend.example .env.backend
# ============================================================

# --- 数据库配置 ---
DATABASE_URL="sqlite:///./data/pathoptix.db"

# --- 应用配置 ---
DEBUG=False

# --- 认证配置（必须修改！）---
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="CHANGE_ME_TO_RANDOM_SECRET_KEY_MIN_32_CHARS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- AI 服务配置（路径优化功能必需）---
DASHSCOPE_API_KEY="sk-b8c968414a3e40118f23bf8bfa6b2bf2"
